<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FolderWatch</AssemblyName>
    <ApplicationIcon>Assets/folderwatch.ico</ApplicationIcon>
    <RootNamespace>FolderWatch.App</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.1.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <Product>FolderWatch</Product>
    <Description>Windows folder snapshot and file change comparison tool</Description>
    <Company>ALMARFELD</Company>
    <Authors>AlinTibi</Authors>
    <Copyright>Copyright (c) 2026 AlinTibi</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/folderwatch.ico" />
    <ProjectReference Include="../FolderWatch.Core/FolderWatch.Core.csproj" />
  </ItemGroup>
</Project>
