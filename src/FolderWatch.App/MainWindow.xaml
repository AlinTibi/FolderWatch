<Window x:Class="FolderWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderWatch" Height="720" Width="1100" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="FolderWatch" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Create folder snapshots and detect file changes." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FolderPathBox" Grid.Column="0" VerticalContentAlignment="Center" Margin="0,0,8,0" IsReadOnly="True" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse" Click="Browse_Click" />
            <Button x:Name="CreateSnapshotButton" Grid.Column="2" Content="Create Snapshot" Click="CreateSnapshot_Click" />
            <Button x:Name="CompareSnapshotButton" Grid.Column="3" Content="Compare Snapshot" Click="CompareSnapshot_Click" Margin="0" />
        </Grid>

        <Expander x:Name="RulesPanel" Grid.Row="2" Header="Snapshot rules (default: scan everything)" Margin="0,0,0,12" IsExpanded="True" Foreground="{StaticResource TextBrush}">
            <StackPanel Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Include:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="IncludeBox" Grid.Column="1" AutomationProperties.Name="Include patterns" ToolTip="Empty means all files. Separate patterns with semicolons." Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="2" Text="Exclude:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="ExcludeBox" Grid.Column="3" AutomationProperties.Name="Exclude patterns" ToolTip="For example: *.tmp; bin; **/cache/**"/>
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="None / Reset" Tag="None" Click="Preset_Click"/>
                    <Button Content="Development folders" Tag="Development" Click="Preset_Click"/>
                    <Button Content="Temporary files" Tag="Temporary" Click="Preset_Click"/>
                    <TextBlock Text="Separate with ;   * = characters in a name   ? = one character   ** = across folders" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                </WrapPanel>
                <TextBlock x:Name="RulesNotice" Text="Names match at any depth; paths are relative to the root. Rules stay in this session and in saved snapshots." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Expander>

        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="FilterCombo" Width="140" SelectionChanged="FilterCombo_SelectionChanged">
                    <ComboBoxItem Content="All" Tag="All" />
                    <ComboBoxItem Content="Added" Tag="Added" />
                    <ComboBoxItem Content="Removed" Tag="Removed" />
                    <ComboBoxItem Content="Modified" Tag="Modified" />
                    <ComboBoxItem Content="Unchanged" Tag="Unchanged" />
                    <ComboBoxItem Content="Inaccessible" Tag="Inaccessible" />
                </ComboBox>
            </StackPanel>

            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,8,0">
                <TextBlock Text="Total:" Foreground="{StaticResource MutedBrush}" Margin="0,0,4,0" />
                <TextBlock x:Name="TotalCountText" Text="0" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock Text="Added:" Foreground="{StaticResource MutedBrush}" Margin="0,0,4,0" />
                <TextBlock x:Name="AddedCountText" Text="0" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock Text="Removed:" Foreground="{StaticResource MutedBrush}" Margin="0,0,4,0" />
                <TextBlock x:Name="RemovedCountText" Text="0" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock Text="Modified:" Foreground="{StaticResource MutedBrush}" Margin="0,0,4,0" />
                <TextBlock x:Name="ModifiedCountText" Text="0" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock Text="Unchanged:" Foreground="{StaticResource MutedBrush}" Margin="0,0,4,0" />
                <TextBlock x:Name="UnchangedCountText" Text="0" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock Text="Inaccessible:" Foreground="{StaticResource MutedBrush}" Margin="0,0,4,0" />
                <TextBlock x:Name="InaccessibleCountText" Text="0" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock x:Name="DurationText" Text="0.00s" Foreground="{StaticResource MutedBrush}" />
            </WrapPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ExportCsvButton" Content="Export CSV" Click="ExportCsv_Click" />
                <Button x:Name="ClearButton" Content="Clear" Click="Clear_Click" Margin="0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <DataGrid x:Name="ResultsGrid"
                      AutoGenerateColumns="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      Foreground="{StaticResource TextBrush}"
                      BorderThickness="0"
                      RowBackground="#1E1E1E"
                      AlternatingRowBackground="#242424">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#292929" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status" Binding="{Binding Change}" Width="130" />
                    <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="*" />
                    <DataGridTextColumn Header="Old size" Binding="{Binding OldSize}" Width="120" />
                    <DataGridTextColumn Header="New size" Binding="{Binding NewSize}" Width="120" />
                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="240" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Cancel scan" Click="Cancel_Click" DockPanel.Dock="Right" Visibility="Collapsed" />
            <ProgressBar x:Name="ProgressBar" Width="160" Height="5" IsIndeterminate="True" Visibility="Collapsed" DockPanel.Dock="Right" />
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
